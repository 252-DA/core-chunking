# ============================================================
# Convention: SECTION__KEY (double underscore)
# e.g. QDRANT__HOST maps to settings.qdrant.host
# ============================================================

# App
APP__ENV=development                 # development | staging | production
APP__DEBUG=false
APP__LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP__JSON_LOGS=false                 # true trong production

# gRPC Server
GRPC__HOST=0.0.0.0
GRPC__PORT=50051
GRPC__MAX_WORKERS=10

# Qdrant (Vector DB)
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__API_KEY=                     # để trống nếu không có auth
QDRANT__COLLECTION_NAME=documents
QDRANT__VECTOR_SIZE=1024             # 1024 cho BGE-M3

# MinIO (File Storage)
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin
MINIO__BUCKET_NAME=documents
MINIO__SECURE=false                  # true nếu dùng HTTPS

# Parser
PARSER__PDF_DPI=150
PARSER__PDF_MAX_PAGES=               # để trống = không giới hạn
PARSER__OCR_ENABLED=true
PARSER__OCR_LANGUAGES=["vi","en"]

# Docling PDF parser (thay thế PyMuPDF)
PARSER__DOCLING_DO_TABLE_STRUCTURE=true
PARSER__DOCLING_DO_OCR=true          # auto-detect: dùng text layer khi có, OCR khi cần
PARSER__DOCLING_DO_PICTURE_DESCRIPTION=false  # bật khi có VLM backend
PARSER__DOCLING_PICTURE_DESCRIPTION_BACKEND=granite  # granite | openai_api

# Chunker
CHUNKER__MAX_CHUNK_SIZE=1500         # chars
CHUNKER__MIN_CHUNK_SIZE=100          # chars
CHUNKER__OVERLAP_SIZE=200            # chars

# Embedder
EMBEDDER__PROVIDER=bge               # bge | openai | sentence_transformers
EMBEDDER__BGE_MODEL=BAAI/bge-m3
EMBEDDER__BGE_USE_FP16=true
EMBEDDER__OPENAI_API_KEY=            # chỉ cần nếu dùng openai
EMBEDDER__OPENAI_MODEL=text-embedding-3-small

# Tracing (OTel → Jaeger/Tempo)
TRACING__ENABLED=false
TRACING__OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING__SERVICE_NAME=document-chunk

# Metrics (Prometheus → Grafana)
METRICS__ENABLED=true
METRICS__PORT=9090
